{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "extensions/pi/**/*.ts",
    "tests/e2e/**/*.ts",
    "packages/protocol/generated/**/*.ts"
  ]
}
